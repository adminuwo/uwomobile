# UwoConnect Mobile Application Environment Configuration
# COPY THIS TO .env FOR LOCAL DEVELOPMENT

# App Environment: development | staging | production
APP_ENV=development

# Backend API Base URL
# For Android Emulator use http://10.0.2.2:8000
# For iOS Simulator / Physical device on LAN use http://<YOUR_LOCAL_IP>:8000 or http://127.0.0.1:8000
API_BASE_URL=http://10.0.2.2:8000

# Optional fallback production API base URL
PROD_API_BASE_URL=https://uwoconnectforrb-743928421487.asia-south1.run.app

# App Metadata
APP_VERSION=1.0.0
