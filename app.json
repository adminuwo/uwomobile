{
  "expo": {
    "name": "UWO Connect",
    "slug": "uwo-connect",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "uwoconnect",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": "1.0.2",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/c984dbb0-9684-4a8b-b459-4f54e0d79b6e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uwo.uwoconnect",
      "buildNumber": "7",
      "deploymentTarget": "15.0",
      "infoPlist": {
        "NSCameraUsageDescription": "UWO Connect requires camera access to attach media to messages and CRM contacts.",
        "NSPhotoLibraryUsageDescription": "UWO Connect requires photo library access to upload media.",
        "NSMicrophoneUsageDescription": "UWO Connect requires microphone access for voice notes and audio calls.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uwo.uwoconnect",
      "versionCode": 49,
      "usesCleartextTraffic": true,
      "largeHeap": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "uwoconnect"
            },
            {
              "scheme": "https",
              "host": "uwoconnect.aisa24.com",
              "pathPrefix": "/auth/qr"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UWO Connect to access your camera to scan QR codes for web login."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.0"
          },
          "android": {
            "minSdkVersion": 24,
            "ndkVersion": "26.1.10909125"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c984dbb0-9684-4a8b-b459-4f54e0d79b6e"
      }
    },
    "owner": "uwo"
  }
}
