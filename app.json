{
  "expo": {
    "name": "UWO Connect",
    "slug": "uwo-connect",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "uwoconnect",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uwo.uwoconnect",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "UWO Connect requires camera access to attach media to messages and CRM contacts.",
        "NSPhotoLibraryUsageDescription": "UWO Connect requires photo library access to upload media.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uwo.uwoconnect",
      "versionCode": 17,
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "uwoconnect"
            },
            {
              "scheme": "https",
              "host": "uwoconnect.aisa24.com",
              "pathPrefix": "/auth/qr"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "react-native-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UWO Connect to access your camera to scan QR codes for web login."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c984dbb0-9684-4a8b-b459-4f54e0d79b6e"
      }
    },
    "owner": "uwo"
  }
}
